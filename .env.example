# Kopiera till .env.local och fyll i värden där. .env.local committas aldrig
# (se CLAUDE.md, avsnitt Säkerhet). Inga hemligheter med prefixet NEXT_PUBLIC_.

# Juridisk koll (adapters/live/LegalAdvisor.ts) — server-only.
# Skaffa på aistudio.google.com. Se docs/moduler/juridisk-koll.md.
GEMINI_API_KEY=

# Webbresearch och Pulsen (adapters/live/{ResearchProvider,PulseProvider}.ts,
# lib/server/tavily.ts) — server-only. Skaffa på tavily.com.
# Se docs/moduler/webbresearch-och-pulsen.md. Bara skelettet är byggt än —
# den riktiga sökningen kommer i modulsessionen.
TAVILY_API_KEY=

# Supabase-nycklar läggs till här när Session P1 bygger inloggningen —
# uppfinn inga variabelnamn i förväg. Registret (Bolagsverket/SCB) och
# Utskick och svar (Gmail OAuth) får sina variabler först när ett
# dataavtal respektive en OAuth-uppsättning faktiskt finns, se
# docs/moduler/registret.md och docs/moduler/utskick-och-svar.md.
