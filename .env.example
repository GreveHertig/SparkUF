# Kopiera till .env.local och fyll i värden där. .env.local committas aldrig
# (se CLAUDE.md, avsnitt Säkerhet). Inga hemligheter med prefixet NEXT_PUBLIC_.

# Juridisk koll (adapters/live/LegalAdvisor.ts) — server-only.
# Skaffa på aistudio.google.com. Se docs/moduler/juridisk-koll.md.
GEMINI_API_KEY=

# Webbresearch och Pulsen (adapters/live/{ResearchProvider,PulseProvider}.ts,
# lib/server/tavily.ts) — server-only. Skaffa på tavily.com.
# Se docs/moduler/webbresearch-och-pulsen.md. Klienten är byggd och används av
# mejlsökningen (steg 05); adaptrarna Webbresearch och Pulsen är fortfarande stubbar —
# frågorna där byggs i deras modulsession.
TAVILY_API_KEY=

# Supabase Auth och plattformens fem liveadaptrar (Profil, Projekt, Resan,
# Evidens, Minnet — lib/server/supabase.ts, proxy.ts). URL och anon-nyckeln
# är publika per Supabases design (samma sak som en klients API-nyckel för
# en tjänst med rader-nivå-säkerhet) — skyddet är RLS-policyerna i
# supabase/migrations/, inte hemlighållande av de här två värdena. Just
# därför får de NEXT_PUBLIC_-prefixet, till skillnad från GEMINI_API_KEY/
# TAVILY_API_KEY ovan. En service role-nyckel används INTE i P1 (varje
# adapter läser/skriver bara den inloggade användarens egna rader via
# dennes session) — lägg aldrig till en sådan här utan att först skriva
# varför i docs/arkitektur.md.
# Skaffa på supabase.com (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opt-in-testet för RLS-isolering (adapters/live/rls.live.test.ts) — två
# testkonton som redan finns i samma Supabase-projekt. Körs inte i CI.
# Se docs/moduler/profil.md.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=

# Registret — licensgrind (lib/server/registryAccess.ts), server-only.
# Tills docs/dataspiken.md §6 fråga 1 är Verifierat får bara Erik och Theodor
# använda liveregisterdata. Båda måste vara satta, annars nekas alla. Värdena
# (kommaseparerade Supabase user.id) läggs bara i .env.local, aldrig här.
# Se docs/moduler/registret.md ("Licensgrind").
# REGISTRY_LIVE_ENABLED måste vara exakt "true" (allt annat nekar).
REGISTRY_LIVE_ENABLED=
REGISTRY_ALLOWED_USER_IDS=

# Utskick, mejlsökning och utkast (steg 05) — grind (lib/server/outreachAccess.ts),
# server-only. Nekat som standard. INGEN sändning finns eller får byggas utan
# uttryckligt ja från Theodor och grundaren. Båda måste vara satta, annars
# nekas allt. OUTREACH_LIVE_ENABLED måste vara exakt "true". Värdena
# (kommaseparerade Supabase user.id för Erik och Theodor) läggs bara i
# .env.local, aldrig här. Se docs/moduler/utskick-och-svar.md.
OUTREACH_LIVE_ENABLED=
OUTREACH_ALLOWED_USER_IDS=

# Bolagsverket, API för värdefulla datamängder (lib/server/bolagsverket.ts),
# server-only. OAuth 2 client credentials från Bolagsverkets Developer Portal.
# Bas-URL:en måste vara https mot *.api.bolagsverket.se; den verifierade
# adressen står i docs/dataspiken.md ("Svarsformat, verifierat mot riktiga
# anrop"). Används bara bakom licensgrinden ovan.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
BOLAGSVERKET_API_BASE_URL=

# SCB:s egna variabler och Utskick och svar (Gmail OAuth) får sina namn först
# när SCB faktiskt visar vad nya API:t utfärdar respektive en OAuth-uppsättning
# finns, se docs/moduler/registret.md och docs/moduler/utskick-och-svar.md.
